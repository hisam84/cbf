# ==============================================================================
# Chavali Blood Foundation - Environment Configuration
# ==============================================================================

# Neon PostgreSQL Database Connection String
# Get your connection string from https://console.neon.tech
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_your_password@ep-sample-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Secret for Admin Authentication (Generate a strong random string)
JWT_SECRET=chavali_blood_foundation_super_secret_jwt_key_2026

# Default Admin Credentials for initial setup (can be changed in Admin Panel)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123

# Server Port (Default: 3000)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=development
